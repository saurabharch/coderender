generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  businessType String   @default("general")
  source       String   @default("contact")
  message      String?
  fingerprint  String?
  createdAt    DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  type        String
  path        String   @default("/")
  fingerprint String?
  data        String?
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("footer")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AppUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("member")
  designation String @default("")
  prefs     String   @default("{}")
  createdAt DateTime @default(now())
}

model MagicToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
}

model Org {
  id        Int      @id @default(autoincrement())
  name      String   @default("CodeRender")
  createdAt DateTime @default(now())
}

model Membership {
  id     Int @id @default(autoincrement())
  userId Int
  orgId  Int @default(1)
  role   String @default("member")
  @@unique([userId, orgId])
}

model Preference {
  key   String @id
  value String @default("")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  audience  String   @default("team")
  createdBy Int?
  createdAt DateTime @default(now())
}

model PartnerRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  city      String   @default("")
  tier      String   @default("referrer")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ClientOrder {
  id        Int      @id @default(autoincrement())
  leadId    Int?
  title     String
  amount    Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  amount    Int
  method    String   @default("upi")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model LicenseKey {
  id              Int      @id @default(autoincrement())
  product         String
  key             String   @unique
  status          String   @default("active")
  maxActivations  Int      @default(1)
  activations     Int      @default(0)
  createdAt       DateTime @default(now())
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  prefix    String
  hash      String   @unique
  scopes    String   @default("leads:write")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Eval {
  id        Int      @id @default(autoincrement())
  threadId  Int?
  score     Int      @default(0)
  rubric    String   @default("")
  createdAt DateTime @default(now())
}

model CmsItem {
  id        Int      @id @default(autoincrement())
  type      String
  slug      String
  data      String   @default("{}")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FormDef {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  fields         String   @default("[]")
  active         Boolean  @default(true)
  schema         String   @default("")
  successMessage String   @default("")
  redirectUrl    String   @default("")
  status         String   @default("active")
  createdBy      String   @default("")
  captcha        String   @default("off")
  createdAt      DateTime @default(now())
}

model Submission {
  id          Int      @id @default(autoincrement())
  formId      Int
  data        String   @default("{}")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  submittedBy String   @default("")
  createdAt   DateTime @default(now())
}

model KanbanBoard {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  formId      Int?
  ownerEmail  String   @default("")
  clientLeadId Int?
  createdAt   DateTime @default(now())
}

model KanbanColumn {
  id      Int @id @default(autoincrement())
  boardId Int
  name    String
  ord     Int @default(0)
}

model KanbanTask {
  id            Int      @id @default(autoincrement())
  boardId       Int
  columnId      Int
  title         String
  body          String   @default("")
  priority      String   @default("medium")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  submissionId  Int?
  archived      Boolean  @default(false)
  startAt       String   @default("")
  dueAt         String   @default("")
  attachments   String   @default("[]")
  startAt       String   @default("")
  dueAt         String   @default("")
  createdAt     DateTime @default(now())
  doneAt        DateTime?
}

model Comment {
  id           Int      @id @default(autoincrement())
  postId       Int      @default(0)
  name         String
  body         String
  status       String   @default("pending")
  resourceType String   @default("")
  resourceId   String   @default("")
  parentId     Int?
  authorEmail  String   @default("")
  likes        Int      @default(0)
  editedAt     String   @default("")
  createdAt    DateTime @default(now())
}

model CommentLike {
  id        Int @id @default(autoincrement())
  commentId Int
  key       String
  @@unique([commentId, key])
}

model KanbanTodo {
  id     Int     @id @default(autoincrement())
  taskId Int
  label  String
  done   Boolean @default(false)
  note   String  @default("")
  ord    Int     @default(0)
}

model TeamTodo {
  id            Int      @id @default(autoincrement())
  title         String
  body          String   @default("")
  status        String   @default("open")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  createdAt     DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  published Boolean  @default(false)
  cover     String   @default("")
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @default("")
  mime      String   @default("")
  size      Int      @default(0)
  folder    String   @default("")
  alt       String   @default("")
  url       String   @default("")
  createdAt DateTime @default(now())
}

model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  createdAt DateTime @default(now())
}

model PageBlock {
  id       Int      @id @default(autoincrement())
  pageSlug String
  ord      Int      @default(0)
  type     String   @default("text")
  title    String   @default("")
  body     String   @default("")
  props    String   @default("{}")
  createdAt DateTime @default(now())
}

model PageVar {
  id       Int      @id @default(autoincrement())
  pageSlug String
  name     String
  value    String   @default("")
  @@unique([pageSlug, name])
}

model GcalToken {
  email        String   @id
  refreshToken String   @default("")
  calendarId   String   @default("primary")
  syncOn       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model GcalEvent {
  taskId    Int      @id
  gEventId  String   @default("")
  day       String   @default("")
  updated   DateTime @default(now())
}

model Job {
  id       Int      @id @default(autoincrement())
  kind     String
  payload  String   @default("{}")
  status   String   @default("queued")
  attempts Int      @default(0)
  runAfter DateTime @default(now())
  error    String   @default("")
  createdAt DateTime @default(now())
}

model BoardMember {
  id        Int      @id @default(autoincrement())
  boardId   Int
  email     String
  role      String   @default("member")
  createdAt DateTime @default(now())
  @@unique([boardId, email])
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  tagline     String   @default("")
  category    String   @default("growth")
  description String   @default("")
  notes       String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PackageService {
  id        Int @id @default(autoincrement())
  packageId Int
  serviceId Int
  @@unique([packageId, serviceId])
}

model ServicePackage {
  id        Int      @id @default(autoincrement())
  serviceSlug String
  name      String
  price     Int      @default(0)
  per       String   @default("one-time")
  timeline  String   @default("")
  includes  String   @default("[]")
  bestFor   String   @default("")
  notes     String   @default("")
  details   String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ticket {
  id            Int      @id @default(autoincrement())
  email         String   @default("")
  subject       String
  body          String   @default("")
  status        String   @default("open")
  assigneeEmail String   @default("")
  escalated     Boolean  @default(false)
  phone         String   @default("")
  createdAt     DateTime @default(now())
}

model TicketEvent {
  id       Int      @id @default(autoincrement())
  ticketId Int
  actor    String   @default("")
  kind     String   @default("note")
  body     String   @default("")
  createdAt DateTime @default(now())
}

model TicketWatcher {
  id       Int    @id @default(autoincrement())
  ticketId Int
  email    String
  @@unique([ticketId, email])
}

model TicketAttachment {
  id       Int      @id @default(autoincrement())
  ticketId Int
  filename String
  mime     String   @default("")
  size     Int      @default(0)
  status   String   @default("pending")
  backend  String   @default("")
  createdAt DateTime @default(now())
}

model Partner {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  tier         String   @default("referrer")
  ratePercent  Float    @default(10)
  code         String   @unique
  status       String   @default("active")
  bankName     String   @default("")
  accountNo    String   @default("")
  ifsc         String   @default("")
  upi          String   @default("")
  bankVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Offer {
  id        Int      @id @default(autoincrement())
  title     String
  code      String   @unique
  kind      String   @default("percent")
  value     Float    @default(0)
  partnerId Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Referral {
  id         Int      @id @default(autoincrement())
  partnerId  Int
  code       String   @default("")
  leadId     Int?
  orderId    Int?
  amount     Int      @default(0)
  commission Int      @default(0)
  status     String   @default("pending")
  period     String   @default("")
  createdAt  DateTime @default(now())
}

model PartnerGoal {
  id        Int    @id @default(autoincrement())
  partnerId Int
  period    String
  kind      String @default("month")
  target    Int    @default(0)
  @@unique([partnerId, period, kind])
}

model PartnerMilestone {
  id        Int      @id @default(autoincrement())
  partnerId Int
  code      String
  at        DateTime @default(now())
  @@unique([partnerId, code])
}

model Payout {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  period       String
  amount       Int      @default(0)
  status       String   @default("requested")
  method       String   @default("")
  confirmToken String   @default("")
  requestedAt  DateTime @default(now())
  paidAt       DateTime?
  confirmedAt  DateTime?
}

model JournalEntry {
  id     Int      @id @default(autoincrement())
  kind   String
  refId  Int      @default(0)
  debit  String   @default("")
  credit String   @default("")
  amount Int      @default(0)
  memo   String   @default("")
  at     DateTime @default(now())
}

model ProviderCred {
  name      String   @id
  payload   String   @default("")
  updatedAt DateTime @updatedAt
}

model WaMessage {
  id        Int      @id @default(autoincrement())
  waId      String   @default("")
  sender    String   @default("")
  body      String   @default("")
  kind      String   @default("in")
  refId     String   @default("")
  createdAt DateTime @default(now())
}

model WaContact {
  phone     String   @id
  name      String   @default("")
  stopped   Boolean  @default(false)
  sentiment Float    @default(0)
  unread    Int      @default(0)
  lastAt    DateTime @default(now())
}

model WaTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  body      String   @default("")
  lang      String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Flow {
  id        Int      @id @default(autoincrement())
  name      String
  trigger   String   @default("{}")
  steps     String   @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FlowRun {
  id        Int      @id @default(autoincrement())
  flowId    Int
  status    String   @default("ok")
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model HookEndpoint {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  secret     String   @default("")
  events     String   @default("[]")
  active     Boolean  @default(true)
  ratePerMin Int      @default(30)
  createdAt  DateTime @default(now())
}

model HookDelivery {
  id         Int      @id @default(autoincrement())
  endpointId Int
  event      String
  payload    String   @default("{}")
  idemKey    String   @default("")
  status     String   @default("queued")
  attempts   Int      @default(0)
  code       Int      @default(0)
  error      String   @default("")
  runAfter   DateTime @default(now())
  createdAt  DateTime @default(now())
}
