generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  businessType String   @default("general")
  source       String   @default("contact")
  message      String?
  fingerprint  String?
  createdAt    DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  type        String
  path        String   @default("/")
  fingerprint String?
  data        String?
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("footer")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AppUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("member")
  designation String @default("")
  prefs     String   @default("{}")
  createdAt DateTime @default(now())
}

model MagicToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
}

model Org {
  id        Int      @id @default(autoincrement())
  name      String   @default("CodeRender")
  createdAt DateTime @default(now())
}

model Membership {
  id     Int @id @default(autoincrement())
  userId Int
  orgId  Int @default(1)
  role   String @default("member")
  @@unique([userId, orgId])
}

model Preference {
  key   String @id
  value String @default("")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  audience  String   @default("team")
  createdBy Int?
  createdAt DateTime @default(now())
}

model PartnerRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  city      String   @default("")
  tier      String   @default("referrer")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ClientOrder {
  id        Int      @id @default(autoincrement())
  leadId    Int?
  title     String
  amount    Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  amount    Int
  method    String   @default("upi")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model LicenseKey {
  id              Int      @id @default(autoincrement())
  product         String
  key             String   @unique
  status          String   @default("active")
  maxActivations  Int      @default(1)
  activations     Int      @default(0)
  createdAt       DateTime @default(now())
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  prefix    String
  hash      String   @unique
  scopes    String   @default("leads:write")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Eval {
  id        Int      @id @default(autoincrement())
  threadId  Int?
  score     Int      @default(0)
  rubric    String   @default("")
  createdAt DateTime @default(now())
}

model CmsItem {
  id        Int      @id @default(autoincrement())
  type      String
  slug      String
  data      String   @default("{}")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FormDef {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  fields         String   @default("[]")
  active         Boolean  @default(true)
  schema         String   @default("")
  successMessage String   @default("")
  redirectUrl    String   @default("")
  status         String   @default("active")
  createdBy      String   @default("")
  captcha        String   @default("off")
  createdAt      DateTime @default(now())
}

model Submission {
  id          Int      @id @default(autoincrement())
  formId      Int
  data        String   @default("{}")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  submittedBy String   @default("")
  createdAt   DateTime @default(now())
}

model KanbanBoard {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  formId      Int?
  ownerEmail  String   @default("")
  clientLeadId Int?
  createdAt   DateTime @default(now())
}

model KanbanColumn {
  id      Int @id @default(autoincrement())
  boardId Int
  name    String
  ord     Int @default(0)
}

model KanbanTask {
  id            Int      @id @default(autoincrement())
  boardId       Int
  columnId      Int
  title         String
  body          String   @default("")
  priority      String   @default("medium")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  submissionId  Int?
  archived      Boolean  @default(false)
  startAt       String   @default("")
  dueAt         String   @default("")
  attachments   String   @default("[]")
  createdAt     DateTime @default(now())
  doneAt        DateTime?
}

model Comment {
  id           Int      @id @default(autoincrement())
  postId       Int      @default(0)
  name         String
  body         String
  status       String   @default("pending")
  resourceType String   @default("")
  resourceId   String   @default("")
  parentId     Int?
  authorEmail  String   @default("")
  likes        Int      @default(0)
  editedAt     String   @default("")
  createdAt    DateTime @default(now())
}

model CommentLike {
  id        Int @id @default(autoincrement())
  commentId Int
  key       String
  @@unique([commentId, key])
}

model KanbanTodo {
  id     Int     @id @default(autoincrement())
  taskId Int
  label  String
  done   Boolean @default(false)
  note   String  @default("")
  ord    Int     @default(0)
}

model TeamTodo {
  id            Int      @id @default(autoincrement())
  title         String
  body          String   @default("")
  status        String   @default("open")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  createdAt     DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  published Boolean  @default(false)
  cover     String   @default("")
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @default("")
  mime      String   @default("")
  size      Int      @default(0)
  folder    String   @default("")
  alt       String   @default("")
  url       String   @default("")
  createdAt DateTime @default(now())
}

model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  createdAt DateTime @default(now())
}

model PageBlock {
  id       Int      @id @default(autoincrement())
  pageSlug String
  ord      Int      @default(0)
  type     String   @default("text")
  title    String   @default("")
  body     String   @default("")
  props    String   @default("{}")
  createdAt DateTime @default(now())
}

model PageVar {
  id       Int      @id @default(autoincrement())
  pageSlug String
  name     String
  value    String   @default("")
  @@unique([pageSlug, name])
}

model GcalToken {
  email        String   @id
  refreshToken String   @default("")
  calendarId   String   @default("primary")
  syncOn       Boolean  @default(true)
  scopes       Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model GcalEvent {
  taskId    Int      @id
  gEventId  String   @default("")
  day       String   @default("")
  updated   DateTime @default(now())
}

model Job {
  id       Int      @id @default(autoincrement())
  kind     String
  payload  String   @default("{}")
  status   String   @default("queued")
  attempts Int      @default(0)
  runAfter DateTime @default(now())
  error    String   @default("")
  createdAt DateTime @default(now())
}

model BoardMember {
  id        Int      @id @default(autoincrement())
  boardId   Int
  email     String
  role      String   @default("member")
  createdAt DateTime @default(now())
  @@unique([boardId, email])
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  tagline     String   @default("")
  category    String   @default("growth")
  description String   @default("")
  notes       String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model PackageService {
  id        Int @id @default(autoincrement())
  packageId Int
  serviceId Int
  @@unique([packageId, serviceId])
}

model ServicePackage {
  id        Int      @id @default(autoincrement())
  serviceSlug String
  name      String
  price     Int      @default(0)
  per       String   @default("one-time")
  timeline  String   @default("")
  includes  String   @default("[]")
  bestFor   String   @default("")
  notes     String   @default("")
  details   String   @default("")
  active    Boolean  @default(true)
  priceLabel String  @default("price")
  mrp       Int      @default(0)
  offerMode String  @default("off")
  offerValue Int     @default(0)
  offerLabel String  @default("offer price")
  badge     String   @default("none")
  createdAt DateTime @default(now())
}

model Ticket {
  id            Int      @id @default(autoincrement())
  email         String   @default("")
  subject       String
  body          String   @default("")
  status        String   @default("open")
  assigneeEmail String   @default("")
  escalated     Boolean  @default(false)
  phone         String   @default("")
  createdAt     DateTime @default(now())
}

model TicketEvent {
  id       Int      @id @default(autoincrement())
  ticketId Int
  actor    String   @default("")
  kind     String   @default("note")
  body     String   @default("")
  createdAt DateTime @default(now())
}

model TicketWatcher {
  id       Int    @id @default(autoincrement())
  ticketId Int
  email    String
  @@unique([ticketId, email])
}

model TicketAttachment {
  id       Int      @id @default(autoincrement())
  ticketId Int
  filename String
  mime     String   @default("")
  size     Int      @default(0)
  status   String   @default("pending")
  backend  String   @default("")
  createdAt DateTime @default(now())
}

model Partner {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  tier         String   @default("referrer")
  ratePercent  Float    @default(10)
  code         String   @unique
  status       String   @default("active")
  bankName     String   @default("")
  accountNo    String   @default("")
  ifsc         String   @default("")
  upi          String   @default("")
  bankVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Offer {
  id        Int      @id @default(autoincrement())
  title     String
  code      String   @unique
  kind      String   @default("percent")
  value     Float    @default(0)
  partnerId Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Referral {
  id         Int      @id @default(autoincrement())
  partnerId  Int
  code       String   @default("")
  leadId     Int?
  orderId    Int?
  amount     Int      @default(0)
  commission Int      @default(0)
  status     String   @default("pending")
  period     String   @default("")
  createdAt  DateTime @default(now())
}

model PartnerGoal {
  id        Int    @id @default(autoincrement())
  partnerId Int
  period    String
  kind      String @default("month")
  target    Int    @default(0)
  @@unique([partnerId, period, kind])
}

model PartnerMilestone {
  id        Int      @id @default(autoincrement())
  partnerId Int
  code      String
  at        DateTime @default(now())
  @@unique([partnerId, code])
}

model Payout {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  period       String
  amount       Int      @default(0)
  status       String   @default("requested")
  method       String   @default("")
  confirmToken String   @default("")
  requestedAt  DateTime @default(now())
  paidAt       DateTime?
  confirmedAt  DateTime?
}

model JournalEntry {
  id     Int      @id @default(autoincrement())
  kind   String
  refId  Int      @default(0)
  debit  String   @default("")
  credit String   @default("")
  amount Int      @default(0)
  memo   String   @default("")
  at     DateTime @default(now())
}

model ProviderCred {
  name      String   @id
  payload   String   @default("")
  updatedAt DateTime @updatedAt
}

model GdocLog {
  id     Int      @id @default(autoincrement())
  email  String   @default("")
  docId  String   @default("")
  title  String   @default("")
  at     DateTime @default(now())
}

model AuthAttempt {
  email       String
  kind        String
  fails       Int    @default(0)
  lockedUntil BigInt @default(0)

  @@id([email, kind])
}

model WaMessage {
  id        Int      @id @default(autoincrement())
  waId      String   @default("")
  sender    String   @default("")
  body      String   @default("")
  kind      String   @default("in")
  refId     String   @default("")
  createdAt DateTime @default(now())
}

model WaContact {
  phone     String   @id
  name      String   @default("")
  stopped   Boolean  @default(false)
  sentiment Float    @default(0)
  unread    Int      @default(0)
  lastAt    DateTime @default(now())
}

model WaTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  body      String   @default("")
  lang      String   @default("en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Flow {
  id        Int      @id @default(autoincrement())
  name      String
  trigger   String   @default("{}")
  steps     String   @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FlowRun {
  id        Int      @id @default(autoincrement())
  flowId    Int
  status    String   @default("ok")
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model HookEndpoint {
  id         Int      @id @default(autoincrement())
  name       String
  url        String
  secret     String   @default("")
  events     String   @default("[]")
  active     Boolean  @default(true)
  ratePerMin Int      @default(30)
  createdAt  DateTime @default(now())
}

model HookDelivery {
  id         Int      @id @default(autoincrement())
  endpointId Int
  event      String
  payload    String   @default("{}")
  idemKey    String   @default("")
  status     String   @default("queued")
  attempts   Int      @default(0)
  code       Int      @default(0)
  error      String   @default("")
  runAfter   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Unit {
  name   String @id
  kind   String @default("pc")
  factor Int    @default(1)
}

model TaxRate {
  id        Int     @id @default(autoincrement())
  name      String
  pct       Float   @default(0)
  inter     Boolean @default(false)
  inclusive Boolean @default(true)
  active    Boolean @default(true)
}

model Coupon {
  code     String @id
  kind     String @default("flat")
  value    Int    @default(0)
  maxOff   Int    @default(0)
  minOrder Int    @default(0)
  startsAt String @default("")
  endsAt   String @default("")
  maxUses  Int    @default(0)
  used     Int    @default(0)
  active   Boolean @default(true)
}

model Customer {
  id        Int    @id @default(autoincrement())
  name      String
  phone     String @default("")
  email     String @default("")
  cgroup    String @default("retail")
  stage     String @default("lead")
  tags      String @default("")
  credit    Int    @default(0)
  balance   Int    @default(0)
  notes     String @default("")
  createdAt DateTime @default(now())
}

model Product {
  id      Int    @id @default(autoincrement())
  name    String
  sku     String @default("")
  kind    String @default("physical")
  price   Int    @default(0)
  mrp     Int    @default(0)
  unit    String @default("pc")
  perPack Int    @default(1)
  taxPct  Float  @default(0)
  stock   Int    @default(0)
  status  String @default("active")
  lowAt   Int    @default(5)
  category String @default("")
  subcategory String @default("")
  shortDesc String @default("")
  description String @default("")
  specs String @default("{}")
  images String @default("[]")
  videos String @default("[]")
  barcode String @default("")
  barcodeType String @default("")
  bin String @default("")
  behavior String @default("stocked")
  avail    String @default("in_stock")
  ratingAvg Float @default(0)
  ratingCount Int @default(0)
  media   String @default("[]")
  seo     String @default("{}")
  attrs   String @default("{}")
  createdAt DateTime @default(now())
}

model ShopOrder {
  id         Int    @id @default(autoincrement())
  customerId Int    @default(0)
  status     String @default("draft")
  subtotal   Int    @default(0)
  discount   Int    @default(0)
  tax        Int    @default(0)
  grand      Int    @default(0)
  coupon     String @default("")
  channel    String @default("admin")
  branchId   Int    @default(1)
  ikey       String @default("")
  notes      String @default("")
  createdAt  DateTime @default(now())
}

model OrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int   @default(0)
  name      String
  qty       Float @default(1)
  price     Int   @default(0)
  total     Int   @default(0)
}

model OrderEvent {
  id      Int    @id @default(autoincrement())
  orderId Int
  event   String
  detail  String @default("")
  at      DateTime @default(now())
}

model Warehouse {
  id       Int    @id @default(autoincrement())
  name     String
  location String @default("")
  active   Boolean @default(true)
}

model StockLevel {
  productId   Int
  warehouseId Int   @default(1)
  qty         Float @default(0)
  avgCost     Int   @default(0)

  @@id([productId, warehouseId])
}

model StockMove {
  id          Int    @id @default(autoincrement())
  productId   Int
  warehouseId Int    @default(1)
  kind        String
  qty         Float  @default(0)
  ref         String @default("")
  cost        Int    @default(0)
  at          DateTime @default(now())
}

model Supplier {
  id      Int    @id @default(autoincrement())
  name    String
  phone   String @default("")
  email   String @default("")
  gstin   String @default("")
  address String @default("")
  rating  Int    @default(0)
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id         Int    @id @default(autoincrement())
  supplierId Int
  status     String @default("draft")
  subtotal   Int    @default(0)
  tax        Int    @default(0)
  grand      Int    @default(0)
  notes      String @default("")
  createdAt  DateTime @default(now())
}

model POLine {
  id        Int   @id @default(autoincrement())
  poId      Int
  productId Int   @default(0)
  name      String
  qty       Float @default(1)
  cost      Int   @default(0)
  total     Int   @default(0)
}

model GRN {
  id    Int    @id @default(autoincrement())
  poId  Int
  lines String @default("[]")
  notes String @default("")
  at    DateTime @default(now())
}

model SupplierBill {
  id         Int    @id @default(autoincrement())
  poId       Int
  supplierId Int
  amount     Int    @default(0)
  status     String @default("unpaid")
  dueAt      String @default("")
  paidAt     String @default("")
}

model StockAlert {
  productId Int    @id
  at        DateTime @default(now())
}

model DocSeq {
  type  String
  year  Int
  next  Int    @default(1)

  @@id([type, year])
}

model BillDoc {
  id         Int    @id @default(autoincrement())
  no         String @unique
  type       String
  customerId Int    @default(0)
  orderId    Int    @default(0)
  lines      String @default("[]")
  subtotal   Int    @default(0)
  discount   Int    @default(0)
  tax        Int    @default(0)
  grand      Int    @default(0)
  status     String @default("draft")
  notes      String @default("")
  createdAt  DateTime @default(now())
}

model BankAccount {
  id      Int     @id @default(autoincrement())
  name    String
  kind    String  @default("cash")
  opening Int     @default(0)
  active  Boolean @default(true)
}

model BankTx {
  id        Int    @id @default(autoincrement())
  accountId Int
  kind      String
  amount    Int    @default(0)
  ref       String @default("")
  notes     String @default("")
  at        DateTime @default(now())
}

model Expense {
  id      Int    @id @default(autoincrement())
  head    String
  amount  Int    @default(0)
  vendor  String @default("")
  billRef String @default("")
  status  String @default("pending")
  notes   String @default("")
  createdAt DateTime @default(now())
}

model Asset {
  id          Int   @id @default(autoincrement())
  name        String
  value       Int   @default(0)
  depPct      Float @default(0)
  purchasedAt String @default("")
  notes       String @default("")
}

model Refund {
  id        Int    @id @default(autoincrement())
  paymentId Int
  orderId   Int    @default(0)
  amount    Int    @default(0)
  reason    String @default("")
  method    String @default("upi")
  at        DateTime @default(now())
}

model CustomerEvent {
  id         Int    @id @default(autoincrement())
  customerId Int
  kind       String
  detail     String @default("")
  at         DateTime @default(now())
}

model LoyaltyAcct {
  customerId Int    @id
  points     Int    @default(0)
  lifetime   Int    @default(0)
  tier       String @default("silver")
}

model LoyaltyTx {
  id         Int    @id @default(autoincrement())
  customerId Int
  delta      Int    @default(0)
  reason     String @default("")
  at         DateTime @default(now())
}

model Review {
  id         Int    @id @default(autoincrement())
  productId  Int    @default(0)
  customerId Int    @default(0)
  rating     Int    @default(5)
  title      String @default("")
  body       String @default("")
  status     String @default("pending")
  createdAt  DateTime @default(now())
}

model Campaign {
  id        Int    @id @default(autoincrement())
  name      String
  channel   String @default("whatsapp")
  segment   String @default("active")
  coupon    String @default("")
  message   String @default("")
  status    String @default("draft")
  runAt     String @default("")
  createdAt DateTime @default(now())
}

model CampaignSend {
  id         Int    @id @default(autoincrement())
  campaignId Int
  customerId Int    @default(0)
  status     String @default("queued")
  detail     String @default("")
  at         DateTime @default(now())
}

model Cart {
  id         Int    @id @default(autoincrement())
  customerId Int    @default(0)
  lines      String @default("[]")
  recovered  Int    @default(0)
  createdAt  DateTime @default(now())
}

model DrawerDay {
  id       Int    @id @default(autoincrement())
  day      String @unique
  openedBy String @default("")
  opening  Int    @default(0)
  counted  Int    @default(0)
  status   String @default("open")
  closedAt String @default("")
}

model Shipment {
  id        Int    @id @default(autoincrement())
  orderId   Int
  courier   String @default("")
  tracking  String @default("")
  zone      String @default("")
  charge    Int    @default(0)
  status    String @default("created")
  notes     String @default("")
  createdAt DateTime @default(now())
}

model ShipZone {
  id     Int    @id @default(autoincrement())
  name   String
  charge Int    @default(0)
  eta    String @default("")
}

model Branch {
  id      Int     @id @default(autoincrement())
  name    String
  address String  @default("")
  phone   String  @default("")
  active  Boolean @default(true)
}

model JobCard {
  id         Int    @id @default(autoincrement())
  no         String @default("")
  customerId Int    @default(0)
  branchId   Int    @default(1)
  service    String @default("")
  staff      String @default("")
  slot       String @default("")
  status     String @default("booked")
  notes      String @default("")
  billId     Int    @default(0)
  createdAt  DateTime @default(now())
}

model PrintTemplate {
  id        Int    @id @default(autoincrement())
  kind      String @unique
  body      String @default("")
  updatedAt DateTime @updatedAt
}

model Employee {
  id          Int     @id @default(autoincrement())
  name        String
  email       String  @default("")
  phone       String  @default("")
  dept        String  @default("")
  designation String  @default("")
  base        Int     @default(0)
  allowances  Int     @default(0)
  deductions  Int     @default(0)
  joinedAt    String  @default("")
  active      Boolean @default(true)
}

model EmpLoan {
  id          Int    @id @default(autoincrement())
  employeeId  Int
  amount      Int    @default(0)
  balance     Int    @default(0)
  installment Int    @default(0)
  status      String @default("open")
  createdAt   DateTime @default(now())
}

model PayrollRun {
  id        Int    @id @default(autoincrement())
  month     String @unique
  status    String @default("draft")
  createdAt DateTime @default(now())
}

model PayrollLine {
  id          Int @id @default(autoincrement())
  runId       Int
  employeeId  Int
  base        Int @default(0)
  allowances  Int @default(0)
  deductions  Int @default(0)
  loanCut     Int @default(0)
  net         Int @default(0)
}

model Attendance {
  employeeId Int
  day        String
  status     String @default("present")

  @@id([employeeId, day])
}

model LeaveReq {
  id         Int    @id @default(autoincrement())
  employeeId Int
  fromDay    String @default("")
  toDay      String @default("")
  kind       String @default("casual")
  status     String @default("pending")
  notes      String @default("")
}

model Timesheet {
  id         Int   @id @default(autoincrement())
  employeeId Int
  day        String @default("")
  hours      Float @default(0)
  taskRef    String @default("")
}

model Budget {
  id      Int    @id @default(autoincrement())
  head    String
  month   String @default("")
  planned Int    @default(0)
}

model ProductVariant {
  id          Int    @id @default(autoincrement())
  productId   Int
  name        String @default("")
  sku         String @default("")
  attrs       String @default("{}")
  price       Int    @default(0)
  mrp         Int    @default(0)
  stock       Int    @default(0)
  barcode     String @default("")
  barcodeType String @default("")
  active      Boolean @default(true)
}

model Wishlist {
  customerId Int
  productId  Int
  at         DateTime @default(now())

  @@id([customerId, productId])
}

model ProductView {
  id         Int    @id @default(autoincrement())
  fp         String @default("")
  customerId Int    @default(0)
  productId  Int
  at         DateTime @default(now())
}

model BinLoc {
  id          Int    @id @default(autoincrement())
  warehouseId Int    @default(1)
  floor       String @default("")
  rack        String @default("")
  shelf       String @default("")
  code        String @default("")
}

model PayIntent {
  id          Int    @id @default(autoincrement())
  ikey        String @unique
  orderId     Int    @default(0)
  billId      Int    @default(0)
  amount      Int    @default(0)
  method      String @default("upi")
  status      String @default("created")
  providerRef String @default("")
  createdAt   DateTime @default(now())
}

model PayLink {
  token     String @id
  billId    Int    @default(0)
  orderId   Int    @default(0)
  amount    Int    @default(0)
  status    String @default("open")
  hits      Int    @default(0)
  createdAt DateTime @default(now())
}

model UpiQr {
  id     Int     @id @default(autoincrement())
  upiId  String
  name   String  @default("")
  amount Int     @default(0)
  label  String  @default("")
  active Boolean @default(true)
}

model ReminderLog {
  id      Int    @id @default(autoincrement())
  billId  Int
  channel String @default("")
  at      DateTime @default(now())
}

model LedgerAcct {
  code String @id
  name String
  type String @default("ASSET")
}

model BizSub {
  id        Int    @id @default(autoincrement())
  plan      String
  cycle     String @default("monthly")
  status    String @default("active")
  renewsAt  String @default("")
  createdAt DateTime @default(now())
}

model BizLoan {
  id          Int    @id @default(autoincrement())
  provider    String @default("")
  principal   Int    @default(0)
  outstanding Int    @default(0)
  rateBps     Int    @default(0)
  tenure      Int    @default(0)
  status      String @default("active")
  createdAt   DateTime @default(now())
}

model BizRepay {
  id     Int    @id @default(autoincrement())
  loanId Int
  amount Int    @default(0)
  at     DateTime @default(now())
}

model HeroSlide {
  id       Int     @id @default(autoincrement())
  image    String  @default("")
  title    String  @default("")
  subtitle String  @default("")
  cta      String  @default("")
  href     String  @default("/")
  anim     String  @default("slide")
  ord      Int     @default(0)
  active   Boolean @default(true)
}

model ProductLot {
  id        Int    @id @default(autoincrement())
  productId Int
  lot       String @default("")
  mfg       String @default("")
  exp       String @default("")
  qty       Float  @default(0)
  cost      Int    @default(0)
  sell      Int    @default(0)
  active    Boolean @default(true)
  notes     String @default("")
  createdAt DateTime @default(now())

  @@index([productId])
}

model Barcode {
  id        Int     @id @default(autoincrement())
  code      String
  normalized String @unique
  type      String  @default("UNKNOWN")
  productId Int     @default(0)
  variantId Int     @default(0)
  isPrimary Boolean @default(false)
  active    Boolean @default(true)
  checkOk   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
}

model BarcodeSeq {
  ns     String @id
  prefix String @default("200")
  next   Int    @default(1)
}

model ProductSerial {
  id        Int    @id @default(autoincrement())
  productId Int
  variantId Int    @default(0)
  serial    String @unique
  status    String @default("IN_STOCK")
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductChannel {
  productId   Int
  channel     String
  enabled     Boolean @default(true)
  onlinePrice Int     @default(0)
  minQty      Float   @default(0)
  maxQty      Float   @default(0)

  @@id([productId, channel])
}

model ProductPrice {
  id        Int    @id @default(autoincrement())
  productId Int
  variantId Int    @default(0)
  priceType String @default("retail")
  amount    Int    @default(0)
  minQty    Float  @default(0)
  startsAt  String @default("")
  endsAt    String @default("")
  active    Boolean @default(true)

  @@index([productId, priceType])
}

model ProductExt {
  productId Int    @id
  kind      String @default("")
  payload   String @default("{}")
  updatedAt DateTime @updatedAt
}

model LoyaltyCard {
  cardNo     String @id
  customerId Int
  active     Boolean @default(true)
  issuedAt   DateTime @default(now())
}

model BgJob {
  id        Int    @id @default(autoincrement())
  assetId   Int
  productId Int    @default(0)
  status    String @default("queued")
  note      String @default("")
  createdAt DateTime @default(now())
}
