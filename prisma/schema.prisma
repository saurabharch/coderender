generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  businessType String   @default("general")
  source       String   @default("contact")
  message      String?
  fingerprint  String?
  createdAt    DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  type        String
  path        String   @default("/")
  fingerprint String?
  data        String?
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("footer")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AppUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  role      String   @default("member")
  prefs     String   @default("{}")
  createdAt DateTime @default(now())
}

model MagicToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
}

model Org {
  id        Int      @id @default(autoincrement())
  name      String   @default("CodeRender")
  createdAt DateTime @default(now())
}

model Membership {
  id     Int @id @default(autoincrement())
  userId Int
  orgId  Int @default(1)
  role   String @default("member")
  @@unique([userId, orgId])
}

model Preference {
  key   String @id
  value String @default("")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  audience  String   @default("team")
  createdBy Int?
  createdAt DateTime @default(now())
}

model PartnerRequest {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  city      String   @default("")
  tier      String   @default("referrer")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ClientOrder {
  id        Int      @id @default(autoincrement())
  leadId    Int?
  title     String
  amount    Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  amount    Int
  method    String   @default("upi")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model LicenseKey {
  id              Int      @id @default(autoincrement())
  product         String
  key             String   @unique
  status          String   @default("active")
  maxActivations  Int      @default(1)
  activations     Int      @default(0)
  createdAt       DateTime @default(now())
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  prefix    String
  hash      String   @unique
  scopes    String   @default("leads:write")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Eval {
  id        Int      @id @default(autoincrement())
  threadId  Int?
  score     Int      @default(0)
  rubric    String   @default("")
  createdAt DateTime @default(now())
}

model CmsItem {
  id        Int      @id @default(autoincrement())
  type      String
  slug      String
  data      String   @default("{}")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FormDef {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  fields         String   @default("[]")
  active         Boolean  @default(true)
  schema         String   @default("")
  successMessage String   @default("")
  redirectUrl    String   @default("")
  status         String   @default("active")
  createdBy      String   @default("")
  createdAt      DateTime @default(now())
}

model Submission {
  id          Int      @id @default(autoincrement())
  formId      Int
  data        String   @default("{}")
  ipAddress   String   @default("")
  userAgent   String   @default("")
  submittedBy String   @default("")
  createdAt   DateTime @default(now())
}

model KanbanBoard {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String   @default("")
  formId      Int?
  ownerEmail  String   @default("")
  createdAt   DateTime @default(now())
}

model KanbanColumn {
  id      Int @id @default(autoincrement())
  boardId Int
  name    String
  ord     Int @default(0)
}

model KanbanTask {
  id            Int      @id @default(autoincrement())
  boardId       Int
  columnId      Int
  title         String
  body          String   @default("")
  priority      String   @default("medium")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  submissionId  Int?
  archived      Boolean  @default(false)
  attachments   String   @default("[]")
  createdAt     DateTime @default(now())
  doneAt        DateTime?
}

model Comment {
  id           Int      @id @default(autoincrement())
  postId       Int      @default(0)
  name         String
  body         String
  status       String   @default("pending")
  resourceType String   @default("")
  resourceId   String   @default("")
  parentId     Int?
  authorEmail  String   @default("")
  likes        Int      @default(0)
  editedAt     String   @default("")
  createdAt    DateTime @default(now())
}

model CommentLike {
  id        Int @id @default(autoincrement())
  commentId Int
  key       String
  @@unique([commentId, key])
}

model KanbanTodo {
  id     Int     @id @default(autoincrement())
  taskId Int
  label  String
  done   Boolean @default(false)
  ord    Int     @default(0)
}

model TeamTodo {
  id            Int      @id @default(autoincrement())
  title         String
  body          String   @default("")
  status        String   @default("open")
  assigneeEmail String   @default("")
  ord           Int      @default(0)
  createdAt     DateTime @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  body      String   @default("")
  published Boolean  @default(false)
  cover     String   @default("")
  createdAt DateTime @default(now())
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @default("")
  mime      String   @default("")
  size      Int      @default(0)
  folder    String   @default("")
  alt       String   @default("")
  url       String   @default("")
  createdAt DateTime @default(now())
}

model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int?
  createdAt DateTime @default(now())
}
