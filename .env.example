# AI chat provider (optional; chat UI honestly reports when unset)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""  (plus OPENAI_BASE_URL + AI_MODEL for compatibles)
# Local model routing (unset = opencode default for everything)
# OPENCODE_MODEL_SIMPLE=""
# OPENCODE_MODEL_SMART=""
# Captcha signing (set a random value in production)
# CAPTCHA_SECRET=""
# Inngest Cloud (optional; local runner covers on-device)
# INNGEST_EVENT_KEY=""
# INNGEST_APP_ID="coderender"
# INNGEST_ENV="production"
# Push (VAPID): run `node scripts/vapid-gen.mjs` once; keys land in .env (gitignored)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:hello@coderender.in"
# GeoLite refresh (needs bandwidth; built-in data works otherwise)
# GEOIP_LICENSE_KEY=""
